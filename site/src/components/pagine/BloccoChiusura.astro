---
// Blocco di chiusura (docs/design/00-sistema-e-componenti.md, sezione «Componente: blocco
// di chiusura»): ultimo blocco del contenuto principale, prima del footer, su SaaS,
// Hosted e On-premise. Contiene il link mailto in stile bottone.
//
// Nota sulla larghezza del bottone: il design chiede piena larghezza al breakpoint di
// base e larghezza automatica da --bp-md. CtaMailto (di L05) impone width:100% sempre,
// quindi la larghezza si governa dal contenitore .azione — che passa a fit-content da
// --bp-md — invece di riscrivere gli stili di un componente di un altro lotto.
import CtaMailto from '../comuni/CtaMailto.astro';
import type { Modalita } from '../../lib/contatto';

interface Props {
  titolo: string;
  frase: string;
  testoCta: string;
  modalita: Modalita;
}

// frase e testoCta sono vicini ma non uguali (la frase chiude col punto, il testo del
// bottone no): sono entrambi testo richiesto alla lettera da un criterio, quindi si
// passano espliciti invece di ricavare l'uno dall'altro.
const { titolo, frase, testoCta, modalita } = Astro.props;
---

<section class="blocco-chiusura">
  <div class="testo">
    <h2>{titolo}</h2>
    <p>{frase}</p>
  </div>
  <div class="azione">
    <CtaMailto modalita={modalita} testo={testoCta} />
  </div>
</section>

<style>
  .blocco-chiusura {
    background: var(--color-bg-surface);
    border-radius: var(--radius-lg);
    padding: var(--spacing-10) var(--spacing-6);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }

  .testo p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .azione {
    width: 100%;
  }

  /* Da --bp-md: testo a sinistra, bottone a destra sulla stessa riga; il bottone prende
     la larghezza del proprio testo e non quella del contenitore. */
  @media (--bp-md) {
    .blocco-chiusura {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .azione {
      width: fit-content;
      flex-shrink: 0;
    }
  }
</style>
