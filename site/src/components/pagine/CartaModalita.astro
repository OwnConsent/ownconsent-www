---
// Carta modalità (docs/design/00-sistema-e-componenti.md, sezione «Componente: carta
// modalità»): usata come sintesi in Home (con link «Scopri di più») e, concettualmente,
// come struttura delle sezioni di SaaS/Hosted/On-premise. La griglia che dispone più
// carte affiancate è responsabilità della pagina che le usa, non di questo componente.
interface Props {
  modalita: string;
  cosaRicevi: string;
  comePaghi: string;
  chiRegistra: string;
  href?: string;
}

const { modalita, cosaRicevi, comePaghi, chiRegistra, href } = Astro.props;
---

<article class="carta-modalita">
  <h3>{modalita}</h3>
  <dl>
    <div class="riga">
      <dt>Cosa ricevi</dt>
      <dd>{cosaRicevi}</dd>
    </div>
    <div class="riga">
      <dt>Come paghi</dt>
      <dd>{comePaghi}</dd>
    </div>
    <div class="riga">
      <dt>Chi registra la CMP presso IAB Europe</dt>
      <dd>{chiRegistra}</dd>
    </div>
  </dl>
  {
    href && (
      <a class="scopri-di-piu" href={href}>
        Scopri di più →
      </a>
    )
  }
</article>

<style>
  .carta-modalita {
    background: var(--color-bg-surface-raised);
    border: var(--border-width) solid var(--color-border-default);
    border-radius: var(--radius-md);
    padding: var(--spacing-6);
  }

  .carta-modalita:hover {
    border-color: var(--color-border-strong);
  }

  .carta-modalita dl {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    margin: 0 0 var(--spacing-4);
  }

  .riga {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .riga dt {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
  }

  .riga dd {
    margin: 0;
    color: var(--color-text-primary);
  }

  .scopri-di-piu {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min-size);
    color: var(--color-text-link);
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
  }
</style>
