---
// Layout comune alle 8 pagine: html lang="it", meta, canonical, token CSS, focus,
// intestazione e piè di pagina (AC1, AC2, ADR-0002 D5, D6). Ordine di tastiera in
// docs/design/00-sistema-e-componenti.md: link "salta al contenuto" per primo.
import 'virtual:token.css';
import '../styles/focus.css';
import '../styles/base.css';
import Header from '../components/comuni/Header.astro';
import Footer from '../components/comuni/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
}

const { title, description, canonical } = Astro.props;
---
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a class="salta-al-contenuto" href="#contenuto">Salta al contenuto</a>
    <Header />
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style>
  /* L09-F1: l'anello di focus sporge dal link di focus-ring-width + focus-ring-offset
     per lato; a inset 0 la sua parte alta e sinistra cadeva fuori dalla viewport. A
     fuoco il link si sposta di quella sporgenza. Solo a fuoco: senza focus resta a
     inset 0 e tutto sopra la viewport («visibile solo al focus», docs/design/00).
     Misura: docs/evidenza/8/l14/sonda-l14.mjs, a pixel sulla schermata. */
  .salta-al-contenuto {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    transform: translateY(-100%);
    background: var(--color-bg-canvas);
    color: var(--color-text-primary);
    padding: var(--spacing-2) var(--spacing-4);
  }

  .salta-al-contenuto:focus {
    inset-block-start: calc(var(--focus-ring-width) + var(--focus-ring-offset));
    inset-inline-start: calc(var(--focus-ring-width) + var(--focus-ring-offset));
    transform: none;
  }
</style>
